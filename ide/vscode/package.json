{
  "name": "reponest-vscode",
  "displayName": "RepoNest",
  "publisher": "sky-jiangcheng",
  "version": "0.1.0",
  "description": "RepoNest inside your IDE: load session context, write session handoffs and search your local knowledge base from the command palette, status bar and sidebar. One VSIX covers VS Code, Cursor and Windsurf.",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Education"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "reponest.loadContext",
        "title": "RepoNest: Load Session Context"
      },
      {
        "command": "reponest.handoff",
        "title": "RepoNest: Write Session Handoff"
      },
      {
        "command": "reponest.search",
        "title": "RepoNest: Search Knowledge"
      },
      {
        "command": "reponest.registerMcp",
        "title": "RepoNest: Register MCP Server (reponest-init)"
      }
    ],
    "configuration": {
      "title": "RepoNest",
      "properties": {
        "reponest.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:18765",
          "description": "RepoNest headless service URL (reponest server)."
        },
        "reponest.projectId": {
          "type": "string",
          "default": "",
          "description": "RepoNest project id used for context / handoff. Empty = let the service resolve the current workspace."
        }
      }
    },
    "views": {
      "reponest-explorer": [
        {
          "id": "reponest.notesSearch",
          "name": "Knowledge Search"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "reponest-explorer",
          "title": "RepoNest",
          "icon": "media/reponest.svg"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.0"
  },
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/sky-jiangcheng/repo-nest.git"
  },
  "homepage": "https://github.com/sky-jiangcheng/repo-nest/tree/master/ide/vscode",
  "bugs": {
    "url": "https://github.com/sky-jiangcheng/repo-nest/issues"
  },
  "keywords": [
    "reponest",
    "knowledge base",
    "session context",
    "handoff",
    "notes",
    "search",
    "claude",
    "cursor",
    "windsurf",
    "mcp"
  ]
}
